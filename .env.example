# Required
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key

# Telegram bot (optional — only needed if running the Telegram bot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional
# CLAUDE_MODEL_EXTRACT=claude-haiku-4-5       # Cheap model for scraping/extraction
# CLAUDE_MODEL_SCORE=claude-sonnet-4-6        # Smart model for ICP scoring
# DB_PATH=data/conference_scanner.db
# PORT=8080

# Deployment (optional)
# WEBHOOK_URL=https://your-service.run.app
