# =============================================================================
# Fireflies AI
# Get your API key: app.fireflies.ai → Settings → Developer Settings → API Key
# =============================================================================
FIREFLIES_API_KEY=your_fireflies_api_key
FIREFLIES_WEBHOOK_SECRET=your_webhook_secret_16_to_32_chars

# =============================================================================
# Anthropic (Claude API)
# Get your API key: console.anthropic.com → API Keys
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key

# =============================================================================
# Slack Bot
# Setup steps:
#   1. Go to api.slack.com/apps → Create New App → From Scratch
#   2. Name: "Meeting Summary Bot", select your workspace
#   3. OAuth & Permissions → Bot Token Scopes: channels:manage, channels:read,
#      chat:write, chat:write.public
#   4. Install to Workspace → Copy the "Bot User OAuth Token" (xoxb-...)
# =============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# =============================================================================
# Google Drive (Service Account)
# Setup steps:
#   1. Google Cloud Console → Create Project → Enable "Google Drive API"
#   2. Credentials → Create Service Account → Download JSON key file
#   3. Set the path to the downloaded JSON key file below
# =============================================================================
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json
GOOGLE_DRIVE_USER_EMAIL=your_email@gmail.com
